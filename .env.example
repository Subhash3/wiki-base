# Application
# Runtime environment name used to select development behavior.
WIKI_BASE_ENVIRONMENT=development
# Minimum severity written to application logs.
WIKI_BASE_LOG_LEVEL=DEBUG
# Directory where process log files are stored.
WIKI_BASE_LOG_DIRECTORY=logs
# Network interface the API server listens on.
WIKI_BASE_HOST=0.0.0.0
# TCP port the API server listens on.
WIKI_BASE_PORT=8000
# Browser origins allowed to call the API.
WIKI_BASE_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Database
# PostgreSQL connection string used by the API and workers.
WIKI_BASE_DATABASE_URL=postgresql://wiki_base:wiki_base@localhost:5432/wiki_base
# Minimum number of connections retained in each database pool.
WIKI_BASE_DATABASE_MIN_POOL_SIZE=1
# Maximum number of connections allowed in each database pool.
WIKI_BASE_DATABASE_MAX_POOL_SIZE=10

# Document ingestion
# Temporary directory used while uploaded documents are processed.
WIKI_BASE_STAGING_DIRECTORY=.wiki-base-staging
# Maximum number of documents accepted in one upload request.
WIKI_BASE_MAX_DOCUMENTS_PER_REQUEST=100
# Maximum size in bytes of an individual uploaded document.
WIKI_BASE_MAX_DOCUMENT_SIZE_BYTES=52428800
# Maximum combined size in bytes of an upload request.
WIKI_BASE_MAX_REQUEST_SIZE_BYTES=524288000
# Comma-separated OCR languages used during document parsing.
WIKI_BASE_OCR_LANGUAGES=english
# Whether OCR runs on every page instead of only when needed.
WIKI_BASE_OCR_FORCE_FULL_PAGE=false
# Approximate maximum number of tokens placed in each chunk.
WIKI_BASE_CHUNK_MAX_TOKENS=700
# Tokenizer model used to measure document chunk sizes.
WIKI_BASE_CHUNK_TOKENIZER_MODEL=BAAI/bge-m3
# Delay in seconds between ingestion-worker job polls.
WIKI_BASE_WORKER_POLL_INTERVAL_SECONDS=1

# Embeddings and Ollama
# Ollama embedding model used to vectorize text.
WIKI_BASE_EMBEDDING_MODEL=bge-m3:latest
# Vector dimension produced by the configured embedding model.
WIKI_BASE_EMBEDDING_DIMENSIONS=1024
# Number of texts embedded in a single provider request.
WIKI_BASE_EMBEDDING_BATCH_SIZE=16
# Base URL of the Ollama API.
WIKI_BASE_OLLAMA_URL=http://127.0.0.1:11434
# Maximum time in seconds to wait for an Ollama request.
WIKI_BASE_OLLAMA_TIMEOUT_SECONDS=120

# Generation providers
# Provider used for entity, relation, and query extraction.
WIKI_BASE_EXTRACTION_PROVIDER=ollama
# Model used by the extraction provider.
WIKI_BASE_EXTRACTION_MODEL=gemma3:270m
# Provider used to generate final answers.
WIKI_BASE_ANSWER_GENERATION_PROVIDER=ollama
# Model used by the answer-generation provider.
WIKI_BASE_ANSWER_GENERATION_MODEL=gemma3:270m

# Groq
# API key used to authenticate with Groq when it is selected.
WIKI_BASE_GROQ_API_KEY=
# Base URL of the Groq-compatible generation API.
WIKI_BASE_GROQ_URL=https://api.groq.com/openai/v1
# Maximum time in seconds to wait for a Groq request.
WIKI_BASE_GROQ_TIMEOUT_SECONDS=120
# Maximum Groq requests permitted per minute locally.
WIKI_BASE_GROQ_REQUESTS_PER_MINUTE=25
# Maximum Groq tokens permitted per minute locally.
WIKI_BASE_GROQ_TOKENS_PER_MINUTE=7000
# Maximum Groq requests permitted per day locally.
WIKI_BASE_GROQ_REQUESTS_PER_DAY=900
# Maximum Groq tokens permitted per day locally.
WIKI_BASE_GROQ_TOKENS_PER_DAY=180000
# Number of times a failed Groq request may be retried.
WIKI_BASE_GROQ_MAX_RETRIES=1
# Reasoning effort requested from supported Groq models.
WIKI_BASE_GROQ_REASONING_EFFORT=low

# Graph indexing and retrieval
# Schema version assigned to newly built graph indexes.
WIKI_BASE_GRAPH_INDEX_VERSION=3
# Minimum similarity required to link a query entity to a graph entity.
WIKI_BASE_GRAPH_ENTITY_SIMILARITY_THRESHOLD=0.75
# Minimum similarity required to link through graph relationships.
WIKI_BASE_GRAPH_RELATIONSHIP_SIMILARITY_THRESHOLD=0.6
# Maximum graph entities linked for each extracted query entity.
WIKI_BASE_GRAPH_ENTITY_MAX_LINKS=1
# Number of graph entities embedded in each indexing batch.
WIKI_BASE_GRAPH_ENTITY_EMBEDDING_BATCH_SIZE=128
# Minimum similarity required to treat graph concepts as synonyms.
WIKI_BASE_GRAPH_SYNONYM_SIMILARITY_THRESHOLD=0.95
# Maximum synonym edges created for each graph concept.
WIKI_BASE_GRAPH_SYNONYM_MAX_LINKS=3
# Maximum relationship depth traversed during facts retrieval.
WIKI_BASE_GRAPH_FACT_MAX_DEPTH=2
# Maximum candidate facts considered before semantic ranking.
WIKI_BASE_GRAPH_FACT_MAX_CANDIDATES=500
# Maximum ranked facts supplied to answer generation.
WIKI_BASE_GRAPH_FACT_MAX_FACTS=12
