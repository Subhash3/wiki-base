WIKI_BASE_ENVIRONMENT=development
WIKI_BASE_LOG_LEVEL=DEBUG
WIKI_BASE_HOST=0.0.0.0
WIKI_BASE_PORT=8000
WIKI_BASE_DATABASE_URL=postgresql://wiki_base:wiki_base@localhost:5432/wiki_base
WIKI_BASE_DATABASE_MIN_POOL_SIZE=1
WIKI_BASE_DATABASE_MAX_POOL_SIZE=10
WIKI_BASE_STAGING_DIRECTORY=.wiki-base-staging
WIKI_BASE_MAX_DOCUMENTS_PER_REQUEST=100
WIKI_BASE_MAX_DOCUMENT_SIZE_BYTES=52428800
WIKI_BASE_MAX_REQUEST_SIZE_BYTES=524288000
WIKI_BASE_EMBEDDING_MODEL=bge-m3:latest
WIKI_BASE_EMBEDDING_DIMENSIONS=1024
WIKI_BASE_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
WIKI_BASE_OLLAMA_URL=http://127.0.0.1:11434
WIKI_BASE_OLLAMA_TIMEOUT_SECONDS=120
WIKI_BASE_EXTRACTION_MODEL=qwen3.5:0.8b
WIKI_BASE_ANSWER_GENERATION_MODEL=qwen3.5:9b
WIKI_BASE_OCR_LANGUAGES=english
WIKI_BASE_OCR_FORCE_FULL_PAGE=false
WIKI_BASE_EMBEDDING_BATCH_SIZE=16
WIKI_BASE_CHUNK_MAX_TOKENS=700
WIKI_BASE_CHUNK_TOKENIZER_MODEL=BAAI/bge-m3
WIKI_BASE_WORKER_POLL_INTERVAL_SECONDS=1
WIKI_BASE_GRAPH_DIRECTORY=.wiki-base-graphs
WIKI_BASE_GRAPH_INDEX_VERSION=1
WIKI_BASE_GRAPH_ENTITY_SIMILARITY_THRESHOLD=0.75
WIKI_BASE_GRAPH_RELATIONSHIP_SIMILARITY_THRESHOLD=0.6
WIKI_BASE_GRAPH_ENTITY_MAX_LINKS=1
WIKI_BASE_GRAPH_ENTITY_EMBEDDING_BATCH_SIZE=128
